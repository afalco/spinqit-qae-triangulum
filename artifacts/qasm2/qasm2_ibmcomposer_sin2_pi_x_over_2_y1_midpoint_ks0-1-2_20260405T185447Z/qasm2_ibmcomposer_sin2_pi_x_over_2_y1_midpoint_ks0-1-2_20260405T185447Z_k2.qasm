ry(0.3926990816987241) q[2];
cx q[1],q[2];
ry(-0.3926990816987241) q[2];
cx q[1],q[2];

// Q = A S0 A^dagger S_psi0
// S_psi0
z q[2];
// A^dagger
ry(-0.3926990816987241) q[2];
cx q[1],q[2];
ry(0.3926990816987241) q[2];
cx q[1],q[2];
